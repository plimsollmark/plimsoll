{
 "about": [
  "Daemon answers every client reads the same way: refusals written by the daemon's own",
  "error path (internal/rpc answers_test.go) and variants no daemon of this version writes.",
  "echo: the request ID's echo matches, is missing, or names another request. The Go,",
  "Python and TypeScript clients' tests run every case. Rewrite: go test ./internal/rpc -run",
  "TestAnswersFileIsTheDaemonsErrorPath -update-answers"
 ],
 "answers": [
  {
   "name": "at capacity",
   "status": 429,
   "contentType": "application/json",
   "body": "{\"code\":\"resource_exhausted\",\"message\":\"sandbox is at capacity, retry shortly\",\"details\":[{\"type\":\"plimsoll.v1.NotDispatched\",\"value\":\"CAY\",\"debug\":{\"reason\":\"NOT_DISPATCHED_REASON_CAPACITY\"}}]}",
   "echo": "match",
   "expect": {
    "code": "resource_exhausted",
    "notDispatched": "capacity",
    "sessionEnded": "",
    "answerNotBound": false
   }
  },
  {
   "name": "at capacity, but the echo is missing",
   "status": 429,
   "contentType": "application/json",
   "body": "{\"code\":\"resource_exhausted\",\"message\":\"sandbox is at capacity, retry shortly\",\"details\":[{\"type\":\"plimsoll.v1.NotDispatched\",\"value\":\"CAY\",\"debug\":{\"reason\":\"NOT_DISPATCHED_REASON_CAPACITY\"}}]}",
   "echo": "missing",
   "expect": {
    "code": "resource_exhausted",
    "notDispatched": "",
    "sessionEnded": "",
    "answerNotBound": true
   }
  },
  {
