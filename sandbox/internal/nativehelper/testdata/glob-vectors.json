{
  "about": "The glob rule of the native helper's list command (docs/session-files.md, \"Glob\"): each case a pattern and paths it must match and must not match, or a pattern that must be refused. Every reader of the rule checks itself against this file: the helper's own tests (program/src/files.rs), and a client that matches the same patterns.",
  "cases": [
    {"pattern": "*.py", "match": ["a.py", ".hidden.py", "x.y.py", ".py"], "no_match": ["a.pyc", "src/a.py", "a.py/b", "py"]},
    {"pattern": "**/*.py", "match": ["a.py", "src/a.py", "src/deep/a.py", ".git/x.py"], "no_match": ["a.pyc", "src/a.txt", "src"]},
    {"pattern": "src/**", "match": ["src", "src/a", "src/a/b/c"], "no_match": ["srcx", "x/src/a"]},
    {"pattern": "src/**/test_*.py", "match": ["src/test_a.py", "src/x/test_b.py", "src/x/y/test_.py"], "no_match": ["src/x/atest_b.py", "test_a.py", "src/x/test_b.pyc"]},
    {"pattern": "**", "match": ["a", "a/b", ".dot"], "no_match": []},
    {"pattern": "a?c", "match": ["abc", "a.c", "a?c"], "no_match": ["ac", "abbc", "a/c"]},
    {"pattern": "[abc]x", "match": ["ax", "bx", "cx"], "no_match": ["dx", "x", "abx"]},
    {"pattern": "[a-c]*", "match": ["a", "b123", "cz"], "no_match": ["d", "A", ""]},
    {"pattern": "[!a-c]*", "match": ["d", "z9", ".x"], "no_match": ["a", "b", "c1"]},
    {"pattern": "[^0-9]", "match": ["a", "-"], "no_match": ["5", "ab"]},
    {"pattern": "[]]", "match": ["]"], "no_match": ["[", "a"]},
    {"pattern": "[]a]", "match": ["]", "a"], "no_match": ["b"]},
    {"pattern": "[a-]", "match": ["a", "-"], "no_match": ["b"]},
    {"pattern": "\\*", "match": ["*"], "no_match": ["a", "**"]},
    {"pattern": "a\\?", "match": ["a?"], "no_match": ["ab"]},
    {"pattern": "[\\]]", "match": ["]"], "no_match": ["\\"]},
    {"pattern": "*", "match": ["a", ".a", "a.b"], "no_match": ["a/b"]},
    {"pattern": "*/*", "match": ["a/b", ".a/.b"], "no_match": ["a", "a/b/c"]},
    {"pattern": "a*b*c", "match": ["abc", "aXbYc", "abbbc", "acbc"], "no_match": ["ab", "acb", "abcd"]},
    {"pattern": "**/node_modules/**", "match": ["node_modules", "x/node_modules/y", "node_modules/a/b"], "no_match": ["node_modulesx/a", "x/node_module/y"]},
    {"pattern": "a/**/b", "match": ["a/b", "a/x/b", "a/x/y/b"], "no_match": ["a", "b", "a/xb", "ab"]},
    {"pattern": "two\nlines", "match": ["two\nlines"], "no_match": ["two lines", "twolines"]},
    {"pattern": "", "invalid": true},
    {"pattern": "a//b", "invalid": true},
    {"pattern": "/a", "invalid": true},
    {"pattern": "a/", "invalid": true},
    {"pattern": "a**", "invalid": true},
    {"pattern": "**b", "invalid": true},
    {"pattern": "[abc", "invalid": true},
    {"pattern": "a\\", "invalid": true}
  ]
}
