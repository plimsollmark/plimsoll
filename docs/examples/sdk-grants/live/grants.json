{
  "profiles": {
    "anthropic": {
      "allow": [
        "POST /v1/messages"
      ],
      "allowed_callers": [
        "sdk-grants-example"
      ],
      "base_url": "https://api.anthropic.com",
      "pass_headers": [
        "anthropic-version"
      ],
      "route_max_calls": {
        "POST /v1/messages": 2
      },
      "sdk_env": {
        "ANTHROPIC_API_KEY": "dummy-anthropic-key-in-the-sandbox",
        "ANTHROPIC_BASE_URL": "{origin}"
      },
      "token": {
        "env": "ANTHROPIC_API_KEY",
        "type": "static"
      }
    },
    "openai": {
      "allow": [
        "POST /v1/chat/completions"
      ],
      "allowed_callers": [
        "sdk-grants-example"
      ],
      "base_url": "https://api.tokenfactory.nebius.com",
      "route_max_calls": {
        "POST /v1/chat/completions": 2
      },
      "sdk_env": {
        "OPENAI_API_KEY": "dummy-openai-key-in-the-sandbox",
        "OPENAI_BASE_URL": "{origin}/v1"
      },
      "token": {
        "env": "NEBIUS_API_KEY",
        "type": "static"
      }
    }
  }
}
