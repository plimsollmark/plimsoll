    {
      "//": "AF_UNIX (1) for the host-API broker's socket and libuv's socketpairs, as in the default.",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "op": "SCMP_CMP_EQ",
          "value": 1
        }
      ],
      "names": [
        "socket",
        "socketpair"
      ]
    },
    {
      "//": "AF_INET (2) stream sockets, protocol 0: the type is masked so only SOCK_NONBLOCK and SOCK_CLOEXEC may join SOCK_STREAM; UDP, raw, SCTP (132) and MPTCP (262) fail the type or protocol check.",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "op": "SCMP_CMP_EQ",
          "value": 2
        },
        {
          "index": 1,
          "op": "SCMP_CMP_MASKED_EQ",
          "value": 4294440959,
          "valueTwo": 1
        },
        {
          "index": 2,
          "op": "SCMP_CMP_EQ",
          "value": 0
        }
      ],
      "names": [
        "socket"
      ]
    },
    {
      "//": "AF_INET (2) stream sockets, IPPROTO_TCP (6).",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "op": "SCMP_CMP_EQ",
          "value": 2
        },
        {
          "index": 1,
          "op": "SCMP_CMP_MASKED_EQ",
          "value": 4294440959,
          "valueTwo": 1
        },
        {
          "index": 2,
          "op": "SCMP_CMP_EQ",
          "value": 6
        }
      ],
      "names": [
        "socket"
      ]
    },
    {
      "//": "Threads and child processes yes; new namespaces no. The masked-eq denies any",
      "//1": "clone carrying CLONE_NEWNS/UTS/IPC/USER/PID/NET/CGROUP (mask 0x7e020000).",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "op": "SCMP_CMP_MASKED_EQ",
          "value": 2114060288,
          "valueTwo": 0
        }
      ],
      "names": [
        "clone"
      ]
    },
    {
      "//": "musl/glibc fall back to clone() when clone3 returns ENOSYS; forcing that keeps",
      "//1": "all thread/process creation on the arg-filtered clone path above.",
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38,
      "names": [
        "clone3"
      ]
    },
    {
      "//": "personality is used to READ the current persona (0xffffffff) and to set the",
      "//1": "benign default; deny the exploit-relevant values like READ_IMPLIES_EXEC.",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "op": "SCMP_CMP_EQ",
          "value": 0
        }
      ],
      "names": [
        "personality"
      ]
    },
    {
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "op": "SCMP_CMP_EQ",
          "value": 4294967295
        }
      ],
      "names": [
        "personality"
      ]
    },
    {
      "//": "mkfifo only: a session's interpreter writes its output to two FIFOs",
      "//1": "(sandbox/internal/sessionkit). The masked-eq allows the call only when the",
      "//2": "file-type bits (S_IFMT, 0170000) are S_IFIFO (0010000): no device, no file.",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 2,
          "op": "SCMP_CMP_MASKED_EQ",
          "value": 61440,
          "valueTwo": 4096
        }
      ],
      "names": [
        "mknodat"
      ]
    },
    {
      "//": "The same for the older mknod, whose mode is its second argument.",
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 1,
          "op": "SCMP_CMP_MASKED_EQ",
          "value": 61440,
          "valueTwo": 4096
        }
      ],
      "names": [
        "mknod"
      ]
    },
    {
