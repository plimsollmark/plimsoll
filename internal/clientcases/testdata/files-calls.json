  {
   "id": "files-call/forged/answer-op",
   "family": "files-call",
   "breaks": "the answer is of another operation than the one asked, its record sealed again: refused by the record's rule, and the session sends nothing more",
   "paths": [
    "files-call"
   ],
   "input": {
    "calls": [
     {
      "call": {
       "op": "write",
       "path": "78",
       "content": "68656c6c6f",
       "mode": "replace",
       "make_parents": false
      }
     },
     {
      "call": {
       "op": "stat",
       "path": "78"
      },
      "forge": "answer-op",
      "rule": true
     },
     {
      "call": {
       "op": "stat",
       "path": "78"
      }
     }
    ]
   },
   "expect": {
    "files-call": {
     "calls": [
      {
       "answer": {
        "outcome": "completed",
        "error": "none",
        "errno": "",
        "op": "write",
        "written": 5
       }
      },
      {
       "refused": "may_have_run",
       "check": "mismatch"
      },
      {
       "refused": "not_dispatched:request"
      }
     ]
    }
